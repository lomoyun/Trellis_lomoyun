{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter @trellis-lite/core build && pnpm --filter @trellis-lite/cli build",
    "typecheck": "pnpm --filter @trellis-lite/core build && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm build && pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "smoke:pack": "pnpm build && node scripts/pack-smoke.mjs",
    "tll": "node packages/cli/bin/tll.js"
  }
}
